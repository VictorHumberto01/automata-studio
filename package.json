{
  "name": "automata-studio",
  "productName": "Automata Studio",
  "version": "1.0.0",
  "description": "Editor e simulador de autômatos (AFD, AFN, AP, MT) — inspirado no JFLAP",
  "private": true,
  "license": "GPL-2.0-only",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron -c blue,magenta \"next dev -p 3123\" \"wait-on http://localhost:3123 && cross-env ELECTRON_DEV=1 electron .\"",
    "dev:web": "next dev -p 3123",
    "build": "next build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.automatastudio.app",
    "productName": "Automata Studio",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education"
    },
    "fileAssociations": [
      {
        "ext": "jff",
        "name": "JFLAP File"
      },
      {
        "ext": "automata",
        "name": "Automata Studio File"
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
